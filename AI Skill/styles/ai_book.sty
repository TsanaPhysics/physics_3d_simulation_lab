% 7. Code Listings (Syntax Highlighting)
\lstset{
  backgroundcolor=\color{codeBg},
  basicstyle=\ttfamily\footnotesize\color{codeText},
  keywordstyle=\bfseries\color{rbruCyan},
  commentstyle=\itshape\color{gray!70},
  stringstyle=\color{rbruGold},
  numberstyle=\tiny\color{gray!50},
  numbers=left,
  numbersep=8pt,
  stepnumber=1,
  breaklines=true,
  breakatwhitespace=false,
  frame=single,
  rulecolor=\color{rbruNavy},
  tabsize=2,
  captionpos=b,
  showstringspaces=false,
  xleftmargin=12pt,
  framexleftmargin=12pt
}

% 8. Headers & Footers
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\color{rbruGray}\thepage\quad\textbar\quad\nouppercase{\leftmark}}
\fancyhead[RO]{\small\color{rbruGray}\nouppercase{\rightmark}\quad\textbar\quad\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rbruGray!40}\leaders\hrule height \headrulewidth\hfill}}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\color{rbruGray}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% 9. Chapter & Section Titles (titlesec)
\usepackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\Large\bfseries\color{rbruNavy}}
  {\filleft\fontsize{36}{42}\selectfont\color{rbruBlue!35}\textbf{บทที่ \thechapter}}
  {1ex}
  {\LARGE\bfseries\filright}
  [\vspace{1ex}{\color{rbruGold}\hrule height 1.5pt}]

\titleformat{\section}
  {\normalfont\Large\bfseries\color{rbruNavy}}
  {\thesection}{1em}{}

\titleformat{\subsection}
  {\normalfont\large\bfseries\color{rbruBlue!90!black}}
  {\thesubsection}{1em}{}

% 10. Hyperlinks (hyperref)
\usepackage[
  colorlinks=true,
  linkcolor=rbruNavy,
  citecolor=rbruEmerald,
  urlcolor=rbruBlue,
  bookmarks=true,
  bookmarksnumbered=true,
  pdfstartview=FitH
]{hyperref}
