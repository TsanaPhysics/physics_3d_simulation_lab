\ProvidesPackage{styles/rbru_book}[2026/10/18 RBRU Academic Textbook & Workshop Handbook Style]

% 1. Paper Geometry (6 x 9 inches - Royal/Pocket 8vo Academic Standard)
\usepackage[
  paperwidth=6in,
  paperheight=9in,
  top=0.75in,
  bottom=0.75in,
  left=1.0in,
  right=0.75in,
  headheight=28pt,
  footskip=0.45in
]{geometry}

% 2. Font & Thai Typography
\usepackage{fontspec}
\defaultfontfeatures{Mapping=tex-text}
\setmainfont{Sarabun}[Scale=1.05]
\setmonofont{Courier New}[Scale=0.90]

\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 0.2pt

% 3. Color Palette (Academic & Modern Technology)
\usepackage[table,xcdraw]{xcolor}
\definecolor{rbruNavy}{HTML}{0A192F}
\definecolor{rbruBlue}{HTML}{0284C7}
\definecolor{rbruCyan}{HTML}{00F0FF}
\definecolor{rbruGold}{HTML}{F59E0B}
\definecolor{rbruEmerald}{HTML}{059669}
\definecolor{rbruPurple}{HTML}{7C3AED}
\definecolor{rbruRose}{HTML}{E11D48}
\definecolor{amber}{HTML}{F59E0B}
\definecolor{rbruGray}{HTML}{475569}
\definecolor{rbruLightBg}{HTML}{F8FAFC}
\definecolor{codeBg}{HTML}{0F172A}
\definecolor{codeText}{HTML}{F8FAFC}

% 4. Essential Math & Graphics Packages
\usepackage{amsmath,amssymb,amsfonts}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{multicol}
\usepackage{enumitem}
\usepackage{caption}
\usepackage{listings}
\usepackage{microtype}
\usepackage{hanging}

% Define JavaScript language for listings
\lstdefinelanguage{JavaScript}{
  keywords={const, let, var, function, return, if, else, for, while, new, true, false, null, undefined, class, constructor},
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]',
  morestring=[b]"
}

% 5. TikZ & Drawing Libraries
\usepackage{tikz}
\usetikzlibrary{calc, shadows, positioning, backgrounds, shapes.geometric, decorations.pathmorphing, arrows.meta}

% 6. TColorBox (Custom Callout Boxes)
\usepackage[most]{tcolorbox}

% 6.1 Teaching Plan Box (แผนการบริหารการสอนประจำบท)
\newtcolorbox{teachingplan}[1]{
  enhanced,
  breakable,
  colback=rbruLightBg,
  colframe=rbruNavy,
  coltitle=white,
  fonttitle=\bfseries\large,
  title={\textbf{[แผนการสอน]} #1},
  arc=4mm,
  boxrule=1.2pt,
  left=12pt,
  right=12pt,
  top=10pt,
  bottom=10pt,
  shadow={2mm}{-2mm}{0mm}{black!15},
  borderline west={4pt}{0pt}{rbruGold}
}

